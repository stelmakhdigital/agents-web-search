{
  "name": "@agents-web-search/pi",
  "version": "1.0.0",
  "description": "Pi (earendil-works) adapter for @agents-web-search/core: a Pi package whose extension registers the core's web tools (pi.registerTool + typebox schemas + 50KB/2000-line truncate).",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "web-search",
    "agents-web-search"
  ],
  "license": "MIT",
  "type": "module",
  "main": "extensions/index.ts",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions/**",
    "src/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agents-web-search/core": "file:../../.vendor/agents-web-search-core-1.0.0.tgz",
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "@agents-web-search/contract": "file:../contract"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stelmakhdigital/agents-web-search.git"
  },
  "homepage": "https://github.com/stelmakhdigital/agents-web-search/tree/master/packages/pi#readme",
  "bugs": {
    "url": "https://github.com/stelmakhdigital/agents-web-search/issues"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
