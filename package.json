{
  "name": "@agents-web-search/adapters",
  "version": "1.0.0",
  "description": "Installable root of the agents-web-search repo (git channel, decision 2026-09-21): the DSH cordis plugin (main + dsh.bundle) and the Pi extension (pi.extensions) in one package; the core ships as the pinned .vendor tarball. pnpm workspace root — sub-packages (packages/*) are the development units.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./packages/dsh/lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh/local-web.cordis.yml"
    }
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions"
    ]
  },
  "dependencies": {
    "@agents-web-search/core": "file:./.vendor/agents-web-search-core-1.0.0.tgz",
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "pack:core": "cd ../core-web-search && npm pack --pack-destination ../../agents-web-search/.vendor/"
  }
}
